; Engine configuration file.
; Edited by hand and by the Godot editor.

config_version=5

[application]

config/name="Arcana (working title)"
config/version="0.17.0"
config/description="Dark-fantasy auto-battler roguelite with tarot court-card figures."
run/main_scene="res://scenes/run.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[internationalization]

locale/translations=PackedStringArray("res://translations/strings.de.translation", "res://translations/strings.en.translation")
locale/fallback="de"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.051, 0.043, 0.063, 1)
